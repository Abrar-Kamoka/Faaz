# ─── SQL Server ────────────────────────────────────────────────────────────────
MSSQL_SA_PASSWORD=YourStrong@Passw0rd
DB_CONNECTION_STRING=Server=mssql,1433;Database=FaazDb;User Id=sa;Password=YourStrong@Passw0rd;TrustServerCertificate=True;

# ─── JWT RS256 (generate with: openssl genrsa -out private.pem 2048) ──────────
# Paste the PEM content as a single line with \n separators
IDENTITY_JWT_PRIVATE_KEY_PEM=

# ─── Service-to-service shared secret ─────────────────────────────────────────
SERVICE_API_KEY=change-me-32-chars-minimum-secret

# ─── Admin seed account ────────────────────────────────────────────────────────
ADMIN_SEED_EMAIL=admin@faaz.co.uk
ADMIN_SEED_PASSWORD=AdminSecret@1234

# ─── SMTP (dev: MailHog, prod: replace with real SMTP) ────────────────────────
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM_EMAIL=no-reply@faaz.co.uk
SMTP_FROM_NAME=Faaz Platform
SMTP_USE_SSL=false

# ─── App base URLs (used in email links) ──────────────────────────────────────
FRONTEND_BASE_URL=http://localhost:3000
IDENTITY_BASE_URL=http://localhost:5101

# ─── Seq structured logging ───────────────────────────────────────────────────
SEQ_URL=http://seq:5341
