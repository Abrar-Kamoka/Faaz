# .env.example is intentionally committed — it documents required variables

# The Identity service appsettings.Development.json contains the RSA private key.
# Each developer must generate their own key:
#   dotnet run --project infra/scripts/GenerateDevKey (or copy from team vault)
src/Services/Identity/Faaz.Services.Identity/appsettings.Development.json

