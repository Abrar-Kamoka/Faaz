{
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "jwks-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/auth/.well-known/{**catch-all}"
        }
      },
      "student-route": {
        "ClusterId": "student-cluster",
        "Match": {
          "Path": "/api/v1/students/{**catch-all}"
        }
      },
      "consultant-route": {
        "ClusterId": "consultant-cluster",
        "Match": {
          "Path": "/api/v1/consultants/{**catch-all}"
        }
      },
      "consultant-profile-route": {
        "ClusterId": "consultant-cluster",
        "Match": {
          "Path": "/api/v1/consultant-profiles/{**catch-all}"
        }
      },
      "notification-hub": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/hubs/notifications/{**catch-all}"
        }
      },
      "booking-api": {
        "ClusterId": "booking",
        "Match": {
          "Path": "/api/bookings/{**catch-all}"
        }
      },
      "booking-reviews": {
        "ClusterId": "booking",
        "Match": {
          "Path": "/api/reviews/{**catch-all}"
        }
      },
      "booking-sessions": {
        "ClusterId": "booking",
        "Match": {
          "Path": "/api/sessions/{**catch-all}"
        }
      },
      "booking-livekit": {
        "ClusterId": "booking",
        "Match": {
          "Path": "/api/v1/livekit/{**catch-all}"
        }
      },
      "payment-api": {
        "ClusterId": "payment",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        }
      },
      "payment-webhook": {
        "ClusterId": "payment",
        "Match": {
          "Path": "/webhooks/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-1": {
            "Address": "http://identity:8080"
          }
        }
      },
      "student-cluster": {
        "Destinations": {
          "student-1": {
            "Address": "http://student:8080"
          }
        }
      },
      "consultant-cluster": {
        "Destinations": {
          "consultant-1": {
            "Address": "http://consultant:8080"
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification-1": {
            "Address": "http://notification:8080"
          }
        }
      },
      "booking": {
        "Destinations": {
          "booking/d1": {
            "Address": "http://booking:8080"
          }
        }
      },
      "payment": {
        "Destinations": {
          "payment/d1": {
            "Address": "http://payment:8080"
          }
        }
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Yarp": "Warning"
      }
    },
    "SeqUrl": "http://seq:5341"
  },
  "AllowedHosts": "*"
}