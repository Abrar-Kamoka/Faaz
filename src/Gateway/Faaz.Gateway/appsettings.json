{
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "jwks-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/auth/.well-known/{**catch-all}"
        }
      },
      "student-route": {
        "ClusterId": "student-cluster",
        "Match": {
          "Path": "/api/v1/students/{**catch-all}"
        }
      },
      "consultant-route": {
        "ClusterId": "consultant-cluster",
        "Match": {
          "Path": "/api/v1/consultants/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-1": {
            "Address": "http://identity:8080"
          }
        }
      },
      "student-cluster": {
        "Destinations": {
          "student-1": {
            "Address": "http://student:8080"
          }
        }
      },
      "consultant-cluster": {
        "Destinations": {
          "consultant-1": {
            "Address": "http://consultant:8080"
          }
        }
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Yarp": "Warning"
      }
    },
    "SeqUrl": "http://seq:5341"
  },
  "AllowedHosts": "*"
}
